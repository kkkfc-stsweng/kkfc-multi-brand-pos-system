// Multi-brand POS Operational Schema (6-Week MVP Edition)
// Bounded string lengths follow docs/schema-limits.md.
// Independent UUID primary keys are generated by Prisma with @default(uuid()).
// Shared primary/foreign keys and composite keys reuse the referenced IDs. All refs are inline.
// modified_at requires application or trigger updates; its default only initializes it.
// Stock ledger (stock_movements) and item balances (inventory_items.quantity_on_hand) must update atomically.

Enum audit_outcomes {
  SUCCESS
  DENIED
  FAILED
}

Enum kitchen_ticket_statuses {
  QUEUED
  ACKNOWLEDGED
  PREPARING
  CHECKING
  REWORKING
  READY
  HANDED_OVER
  CANCELLED
}

Enum order_channels {
  DINE_IN
  TAKEAWAY
  GRABFOOD
  FOODPANDA
}

Enum order_statuses {
  DRAFT
  CONFIRMED
  PREPARING
  REWORKING
  CHECKING
  READY
  COMPLETED
  CANCELLED
}

Enum user_roles {
  ORDER_STAFF
  KITCHEN_PREPARER
  INVENTORY_STAFF
  KITCHEN_HEAD
  OWNER
  SUPERADMIN
}

Enum recipe_types {
  MENU_ASSEMBLY
  PRODUCTION
}

Enum inventory_types {
  RAW
  PREPPED
  PACKAGING
}

Enum receipt_statuses {
  DRAFT
  ACCEPTED
  CANCELLED
}

Enum count_statuses {
  DRAFT
  SUBMITTED
  REVIEWED
}

Enum adjustment_statuses {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

Enum stock_movement_types {
  RECEIPT
  ORDER_CONSUMPTION
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  PRODUCTION_RETURN
  WASTE
  ADJUSTMENT
  REVERSAL
}

Enum production_statuses {
  DRAFT
  APPROVED
  IN_PROGRESS
  AWAITING_QC
  HELD
  REWORKING
  ACCEPTED
  REJECTED
  CANCELLED
}

Enum payment_methods {
  CASH
  E_WALLET          
  CARD              
  PLATFORM_SETTLED
}

Enum payment_statuses {
  UNPAID
  PAID
  REFUNDED
}


// ==========================================
// 1. USERS, RBAC & BRANDS
// ==========================================

// Stores user accounts, credentials, and operational roles, including Superadmin and Owner.
// Every user can be assigned to at most one brand; null means unassigned.
// Used to enforce role-based access control across privileged actions, approvals, and confidential recipes (FR-004, FR-029, AC-08).
Table users {
  user_id uuid [pk]
  username varchar(64) [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  password_hash varchar(255) [not null]
  role user_roles [not null]
  brand_id uuid [ref: > brands.brand_id]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (brand_id)
  }
}

// Stores revocable sessions. The backend enforces expiration and records activity.
Table user_sessions {
  session_id uuid [pk]
  user_id uuid [not null, ref: > users.user_id]
  token_hash varchar(64) [not null, unique, note: 'SHA-256 hex digest; never store the raw bearer token']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  last_seen_at timestamp [not null, default: `now()`]
  indexes {
    (user_id)
  }
}

// Represents the distinct food brands operating out of the single shared kitchen pilot (2-3 brands for MVP).
// Provides stable brand identities for catalog separation, order tagging, and historical demand tracking (FR-001, FR-024).
Table brands {
  brand_id uuid [pk]
  code char(4) [not null, unique, note: 'Four uppercase letters derived from the brand name on creation and renaming; name-based prefix retained on collision.']
  name varchar(150) [not null]
  logo_url varchar(2048)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// ==========================================
// 2. CATALOG, RECIPES & MODIFIERS
// ==========================================

// Defines versioned Bills of Materials (BOM) for both menu item assembly (MENU_ASSEMBLY) and bulk raw-to-prepared conversion (PRODUCTION).
// Isolates confidential cooking instructions from standard BOM quantities so method details are never exposed to unauthorized roles (FR-004, FR-020, BR-03).
Table recipes {
  recipe_id uuid [pk]
  code varchar(64) [not null]
  name varchar(150) [not null]
  type recipe_types [not null]
  output_inventory_item_id uuid [ref: > inventory_items.inventory_item_id]
  expected_output_quantity decimal(14,3)
  serving_description varchar(255)
  instructions varchar(10000) [note: 'Restricted field; exclude from unauthorized API responses (FR-004)']
  notes varchar(2000)
  version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (code, version) [unique]
  }
  Note: 'MENU_ASSEMBLY: components per serving. PRODUCTION: components per standard batch, with an output inventory item and expected yield.'
}

// Lists the exact raw, prepared, or packaging inventory items and base-unit quantities required by a recipe.
// Drives single-deduction BOM calculations for menu sales and expected input requirements for production batches (FR-002, FR-004, FR-023).
Table recipe_components {
  recipe_component_id uuid [pk]
  recipe_id uuid [not null, ref: > recipes.recipe_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  quantity decimal(14,3) [not null]
  notes varchar(2000)
  indexes {
    (recipe_id, inventory_item_id) [unique]
  }
  Note: 'Quantity uses the ingredient inventory item base unit. Ingredients may be raw, prepared or packaging items.'
}

// Stores the sellable food, drink, and bundle configurations offered under each brand catalog.
// Links each sellable product to its active assembly recipe and default price (FR-001, FR-002).
Table menu_items {
  menu_item_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  recipe_id uuid [ref: > recipes.recipe_id]
  menu_item_url varchar(2048)
  code varchar(64) [unique, not null]
  name varchar(150) [not null]
  description varchar(2000)
  serving_description varchar(255)
  base_price decimal(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (brand_id, is_active)
  }
}

// Configures channel-specific pricing and availability controls (Dine-In, Takeaway, GrabFood, foodpanda) for each menu item.
// Allows staff to toggle item availability and apply platform-specific prices during order encoding (FR-003).
Table menu_item_channels {
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  order_channel order_channels [not null]
  price decimal(12,2) [not null]
  is_available boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (menu_item_id, order_channel) [pk]
  }
  Note: 'Channel-specific price and availability overrides (FR-003).'
}

// Drop: Enum modifier_component_actions
// Drop: Table modifier_components

// Defines reusable order add-ons, substitutions, or special preparation instructions across the catalog.
// Optionally links directly to a shared inventory item and base-unit quantity when the modifier consumes extra stock (FR-002, FR-023).
Table modifiers {
  modifier_id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  description varchar(2000)
  inventory_item_id uuid [ref: > inventory_items.inventory_item_id, note: 'Optional: ingredient consumed when this add-on is chosen (FR-002)']
  quantity decimal(14,3) [note: 'Quantity in inventory_item base_unit per serving']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Maps which modifiers are allowed for a specific menu item and defines any item-specific add-on price.
// Restricts staff order entry to valid item-modifier combinations configured for that brand (FR-002, FR-005).
Table menu_item_modifiers {
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  additional_price decimal(12,2) [not null, default: 0]
  indexes {
    (menu_item_id, modifier_id) [pk]
  }
}


// ==========================================
// 3. ORDERS & KITCHEN TICKETS
// ==========================================

// Captures staff-entered orders tagged by brand and sales channel, including dine-in table numbers and external delivery platform references.
// Enforces duplicate prevention on external platform orders, tracks order lifecycle timestamps, and preserves cancellation reasons (FR-005, FR-006, FR-008, FR-010, BR-13).
Table orders {
  order_id uuid [pk]
  brand_id uuid [not null, ref: > brands.brand_id]
  created_by_id uuid [not null, ref: > users.user_id]
  order_channel order_channels [not null]
  merchant_store_reference varchar(255) [note: 'Stable platform store ID or configured store code; null for internal orders']
  external_order_reference varchar(255) [note: 'Platform order ID; null for internal orders']
  table_reference varchar(50)
  status order_statuses [not null, default: 'DRAFT']
  payment_method payment_methods [note: 'Null while DRAFT; set upon confirmation or payment']
  payment_status payment_statuses [not null, default: 'UNPAID']
  payment_reference varchar(255) [note: 'Optional e-wallet/card reference number']
  notes varchar(2000)
  cancelled_by_id uuid [ref: > users.user_id]
  cancellation_reason varchar(1000)
  cancelled_at timestamp
  confirmed_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (order_channel, merchant_store_reference, external_order_reference) [unique]
    (brand_id, created_at)
  }
}

// Stores the individual sellable items, quantities, and confirmed unit prices within an order.
// Snapshots the active recipe version (applied_recipe_id) upon confirmation so later recipe edits never alter historical BOM attribution (FR-005, FR-023, AC-18).
Table order_items {
  order_item_id uuid [pk]
  order_id uuid [not null, ref: > orders.order_id]
  menu_item_id uuid [not null, ref: > menu_items.menu_item_id]
  applied_recipe_id uuid [ref: > recipes.recipe_id, note: 'Snapshots active recipe version at confirmation for historical BOM integrity (AC-18)']
  item_name varchar(150) [not null]
  quantity integer [not null]
  unit_price decimal(12,2) [not null]
  notes varchar(2000)
  indexes {
    (order_id)
  }
}

// Records the specific modifiers and snapshotted add-on prices selected for an individual order line item.
// Ensures kitchen tickets and stock consumption calculations reflect the exact customizations ordered by the customer (FR-002, FR-005).
Table order_item_modifiers {
  order_item_modifier_id uuid [pk]
  order_item_id uuid [not null, ref: > order_items.order_item_id]
  modifier_id uuid [not null, ref: > modifiers.modifier_id]
  modifier_name varchar(150) [not null]
  additional_price decimal(12,2) [not null, default: 0]
  indexes {
    (order_item_id, modifier_id) [unique]
  }
}

// Manages the kitchen fulfillment and quality-control workflow for a confirmed order from queue to handover.
// Enforces distinct states for preparation, checker verification (CHECKING), rework on failed QC (REWORKING), READY, and final handover (FR-009, AC-06, BR-11, BR-12).
Table kitchen_tickets {
  kitchen_ticket_id uuid [pk]
  order_id uuid [not null, unique, ref: - orders.order_id]
  ticket_number varchar(64) [not null, unique]
  status kitchen_ticket_statuses [not null, default: 'QUEUED']
  preparer_id uuid [ref: > users.user_id]
  checker_id uuid [ref: > users.user_id]
  created_by_id uuid [not null, ref: > users.user_id]
  acknowledged_at timestamp
  preparation_started_at timestamp
  ready_at timestamp
  handed_over_at timestamp
  cancelled_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  indexes {
    (status, created_at)
  }
  Note: 'Created when an order is confirmed. State transitions and QC failures are logged in audit_logs.'
}

// ==========================================
// 4. SHARED INVENTORY, RECEIVING & COUNTS
// ==========================================

// Maintains the single shared catalog of raw materials, prepared derivatives, and packaging items across all brands.
// Tracks each item's canonical base unit, optional pack conversion factor, and cached usable on-hand stock balance (FR-011, AC-01, BR-10).
Table inventory_items {
  inventory_item_id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  type inventory_types [not null]
  base_unit varchar(16) [not null, note: 'Canonical unit: g, ml, pc (FR-011)']
  pack_unit varchar(16) [note: 'Optional counting/receiving unit, e.g., pack, box (BR-10)']
  pack_to_base_factor decimal(14,3) [note: 'Base units per 1 pack_unit (FR-011)']
  quantity_on_hand decimal(14,3) [not null, default: 0, note: 'Cached usable stock; must equal SUM(stock_movements.quantity_change)']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Records supplier or market delivery headers, reference documents, and acceptance sign-off metadata.
// Ensures only verified and authorized receiving events can increase usable shared stock (FR-013, BR-04).
Table goods_receipts {
  goods_receipt_id uuid [pk]
  receipt_number varchar(64) [not null, unique]
  supplier_name varchar(200) [not null]
  supplier_document_reference varchar(255)
  status receipt_statuses [not null, default: 'DRAFT']
  received_at timestamp [not null]
  created_by_id uuid [not null, ref: > users.user_id]
  accepted_by_id uuid [ref: > users.user_id]
  accepted_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Captures line-level delivered, accepted, and rejected quantities along with informational supplier batch and expiry data.
// Guarantees that only physically accepted quantities are posted to shared inventory while preserving rejection reasons (FR-013, FR-022, AC-03, BR-05).
Table goods_receipt_items {
  goods_receipt_item_id uuid [pk]
  goods_receipt_id uuid [not null, ref: > goods_receipts.goods_receipt_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  supplier_batch_reference varchar(255) [note: 'Informational lot/batch reference (FR-022)']
  use_by_at timestamp [note: 'Informational expiry date (FR-022 / FR-027)']
  delivered_quantity decimal(14,3) [not null]
  accepted_quantity decimal(14,3) [not null, default: 0]
  rejected_quantity decimal(14,3) [not null, default: 0]
  rejection_reason varchar(1000)
  notes varchar(2000)
  indexes {
    (goods_receipt_id)
  }
}

// Manages physical inventory count sessions anchored to a consistent cutoff timestamp.
// Separates physical count observation and supervisor review from automatic stock balance mutation (FR-014, AC-14).
Table stock_counts {
  stock_count_id uuid [pk]
  status count_statuses [not null, default: 'DRAFT']
  cutoff_at timestamp [not null]
  created_by_id uuid [not null, ref: > users.user_id]
  reviewed_by_id uuid [ref: > users.user_id]
  submitted_at timestamp
  reviewed_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// Records the expected ledger balance versus the physically counted quantity for each inventory item at the count cutoff.
// Leaves any variance as an unresolved observation awaiting review rather than automatically classifying it as waste or theft (FR-014, FR-016, AC-05, BR-06).
Table stock_count_items {
  stock_count_item_id uuid [pk]
  stock_count_id uuid [not null, ref: > stock_counts.stock_count_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  expected_quantity decimal(14,3) [not null, note: 'Captured at cutoff_at; counting does not auto-adjust stock (FR-014)']
  counted_quantity decimal(14,3) [not null]
  counted_by_id uuid [not null, ref: > users.user_id]
  counted_at timestamp [not null]
  notes varchar(2000)
  indexes {
    (stock_count_id, inventory_item_id) [unique]
  }
}

// Tracks reason-coded stock correction requests and verified spoilage/waste reports requiring supervisor approval.
// Distinguishes confirmed waste from count discrepancy resolutions and posts to the stock ledger only when approved (FR-015, FR-016, AC-08, AC-17).
Table stock_adjustments {
  stock_adjustment_id uuid [pk]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  stock_count_item_id uuid [ref: > stock_count_items.stock_count_item_id, note: 'Null for standalone spoilage/waste']
  status adjustment_statuses [not null, default: 'PENDING']
  quantity_change decimal(14,3) [not null, note: 'Signed quantity in base_unit']
  is_waste boolean [not null, default: false, note: 'Separates verified spoilage/waste from count variance resolution (FR-016)']
  reason_code varchar(64) [not null]
  reason varchar(1000) [not null]
  requested_by_id uuid [not null, ref: > users.user_id]
  reviewed_by_id uuid [ref: > users.user_id]
  reviewed_at timestamp
  review_notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
}

// ==========================================
// 5. PRODUCTION, CONVERSION & PREP ADVICE
// ==========================================

// Manages both non-posting preparation recommendations/plans (DRAFT) with override rationale and the physical raw-to-prepared conversion batch lifecycle.
// Records produced, accepted, and lost output quantities along with batch use-by dates, ensuring held or rejected batches never enter usable stock (FR-018, FR-020, FR-021, FR-022, FR-025, FR-026, BR-07, BR-08).
Table production_batches {
  production_batch_id uuid [pk]
  batch_number varchar(64) [not null, unique, note: 'Batch ID for traceability (FR-022)']
  recipe_id uuid [not null, ref: > recipes.recipe_id]
  status production_statuses [not null, default: 'DRAFT']
  recommended_quantity decimal(14,3) [note: 'Non-posting baseline recommendation (FR-025)']
  target_output_quantity decimal(14,3) [not null, note: 'Planned or overridden target output in recipe output item base_unit (FR-018/026)']
  override_reason varchar(1000) [note: 'Kitchen Head rationale if target differs from recommended (FR-026 / AC-07)']
  produced_quantity decimal(14,3) [not null, default: 0]
  accepted_quantity decimal(14,3) [not null, default: 0, note: 'Only posts to stock_movements when status = ACCEPTED (FR-020/021)']
  loss_quantity decimal(14,3) [not null, default: 0, note: 'Documented process/QC loss in output item base_unit (FR-020)']
  loss_reason varchar(1000)
  use_by_at timestamp [note: 'Prepared batch expiry date (FR-022)']
  created_by_id uuid [not null, ref: > users.user_id]
  preparer_id uuid [ref: > users.user_id]
  checker_id uuid [ref: > users.user_id]
  approved_by_id uuid [ref: > users.user_id]
  approved_at timestamp
  scheduled_at timestamp
  started_at timestamp
  completed_at timestamp
  notes varchar(2000)
  created_at timestamp [not null, default: `now()`]
  modified_at timestamp [not null, default: `now()`]
  Note: 'Recipe must be PRODUCTION. DRAFT status serves as the non-posting preparation plan.'
}

// Records the actual raw material quantities physically issued to a production batch and any recoverable unused inputs returned to stock.
// Keeps raw material consumption during preparation distinct from subsequent menu sales to prevent double deduction (FR-019, FR-020, FR-023, BR-09).
Table production_batch_inputs {
  production_batch_input_id uuid [pk]
  production_batch_id uuid [not null, ref: > production_batches.production_batch_id]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  issued_quantity decimal(14,3) [not null, note: 'Physically issued raw input deducted on issue (FR-019)']
  returned_quantity decimal(14,3) [not null, default: 0, note: 'Recoverable unused input returned to stock (FR-020)']
  return_reason varchar(1000)
  issued_by_id uuid [not null, ref: > users.user_id]
  issued_at timestamp [not null]
  notes varchar(2000)
  indexes {
    (production_batch_id)
  }
}

// ==========================================
// 6. IMMUTABLE LEDGER & AUDIT TRAIL
// ==========================================

// Serves as the immutable, append-only ledger of all physical inventory additions, deductions, adjustments, and reversals.
// Enforces idempotency via posting_key and links every balance change to its exact originating operational record (FR-012, FR-017, NFR-002, NFR-003, AC-04, AC-12).
Table stock_movements {
  stock_movement_id uuid [pk]
  inventory_item_id uuid [not null, ref: > inventory_items.inventory_item_id]
  type stock_movement_types [not null]
  quantity_change decimal(14,3) [not null, note: 'Signed quantity in the inventory item base unit']
  posting_key varchar(255) [not null, unique, note: 'Idempotency key preventing duplicate posting (FR-017 / NFR-002 / AC-12)']
  reverses_movement_id uuid [ref: > stock_movements.stock_movement_id]
  goods_receipt_item_id uuid [ref: > goods_receipt_items.goods_receipt_item_id]
  stock_adjustment_id uuid [ref: > stock_adjustments.stock_adjustment_id]
  order_item_id uuid [ref: > order_items.order_item_id]
  production_batch_id uuid [ref: > production_batches.production_batch_id]
  created_by_id uuid [not null, ref: > users.user_id]
  reason varchar(1000)
  occurred_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  indexes {
    (inventory_item_id, occurred_at)
  }
  Note: 'Immutable item-level stock ledger.'
}

// Provides a unified, append-only audit trail for consequential events, state transitions, order/recipe edits, and denied access attempts.
// Preserves actor identity, timestamps, reasons, and before/after JSON snapshots without permitting silent edits or deletions (FR-008, FR-030, NFR-006, AC-08, AC-17).
Table audit_logs {
  audit_log_id uuid [pk]
  actor_id uuid [ref: > users.user_id]
  action varchar(100) [not null, note: 'ORDER_CONFIRMED, TICKET_QC_FAILED, BATCH_HELD, RECIPE_VIEW_DENIED, etc.']
  entity_type varchar(64) [not null, note: 'orders, kitchen_tickets, production_batches, recipes, stock_adjustments, etc.']
  entity_id uuid
  outcome audit_outcomes [not null]
  reason varchar(1000)
  before_data jsonb
  after_data jsonb
  request_id varchar(128)
  created_at timestamp [not null, default: `now()`]
  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
  }
  Note: 'Unified append-only audit history for orders, kitchen tickets, production batches, recipes and RBAC denials.'
}
